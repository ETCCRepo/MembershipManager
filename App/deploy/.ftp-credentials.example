# Copy this file to .ftp-credentials (same directory, gitignored) and fill in
# the real values. deploy/ftp-deploy.sh reads this file at runtime if the
# FTP_HOST/FTP_USER/FTP_PASS environment variables aren't already set —
# same pattern as the CarShow app's deploy/.ftp-credentials.
#
# KEY=VALUE, one per line, no quotes.
FTP_HOST=
FTP_USER=
FTP_PASS=
